# Copy to the checkout's .env.local, or set these variables in your shell / CI.
# Never commit .env.local. Values are literal; shell commands are not evaluated.
SCALEWAY_ACCESS_KEY=
SCALEWAY_SECRET_KEY=
SCALEWAY_PROJECT_ID=
SCALEWAY_ZONE=fr-par-1

VIBEKE_DEPLOY_NAME=vibeke-relay
VIBEKE_RELAY_DOMAIN=relay.vibeke.dev
VIBEKE_SSH_KEY=~/.ssh/id_ed25519
# Restrict this to the deployment runner's public IPv4 range if it is fixed.
VIBEKE_SSH_CIDR=0.0.0.0/0
# Optional: existing known_hosts file. When set, SSH requires a matching host key.
# VIBEKE_KNOWN_HOSTS=/path/to/known_hosts
