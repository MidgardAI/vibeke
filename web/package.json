{
  "name": "vibeke-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/pwa dev",
    "build": "bun run --cwd apps/pwa build",
    "preview": "bun run --cwd apps/pwa preview",
    "dev:site": "bun run --cwd apps/site dev",
    "build:site": "bun run --cwd apps/site build",
    "preview:site": "bun run --cwd apps/site preview",
    "e2e:site": "bun run --cwd apps/site e2e",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build:desktop": "bun run --cwd apps/desktop build",
    "test:desktop": "bun run --cwd apps/desktop test",
    "dist:desktop": "bun run --cwd apps/desktop dist",
    "e2e:desktop": "bun run --cwd apps/desktop e2e",
    "test": "bun test packages apps",
    "typecheck": "bun run --filter '*' typecheck",
    "icons": "bun scripts/brand-icons.ts && bun apps/pwa/scripts/gen-icons.ts && bun apps/desktop/scripts/gen-icons.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "sharp": "0.35.5",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "electron"
  ]
}
